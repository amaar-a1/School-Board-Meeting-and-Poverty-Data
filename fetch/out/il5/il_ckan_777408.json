05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05e9\u05dc 0.4% \u05dc\u05e2\u05d5\u05de\u05ea \u05d7\u05d5\u05d3\u05e9 \u05e1\u05e4\u05d8\u05de\u05d1\u05e8 \u05d1\u05d5 \u05d4\u05ea\u05d9\u05d9\u05e6\u05d1\u05d5 164.2 \u05d0\u05dc\u05e3 \u05d3\u05d5\u05e8\u05e9\u05d9 \u05e2\u05d1\u05d5\u05d3\u05d4 (\u05de\u05e0\u05d5\u05db\u05d4 \u05e2\u05d5\u05e0\u05ea\u05d9\u05d5\u05ea).\r\n\r\n\u05de\u05e1\u05e4\u05e8 \u05ea\u05d5\u05d1\u05e2\u05d9 \u05d4\u05d0\u05d1\u05d8\u05dc\u05d4 \u05d1\u05d7\u05d5\u05d3\u05e9 \u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 \u05e2\u05de\u05d3 \u05e2\u05dc 103.1 \u05d0\u05dc\u05e3 (\u05de\u05e0\u05d5\u05db\u05d4 \u05e2\u05d5\u05e0\u05ea\u05d9\u05d5\u05ea), \u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05dc 2.4% \u05dc\u05e2\u05d5\u05de\u05ea \u05d7\u05d5\u05d3\u05e9 \u05e1\u05e4\u05d8\u05de\u05d1\u05e8, \u05d0\u05d6 \u05e2\u05de\u05d3 \u05de\u05e1\u05e4\u05e8\u05dd \u05e2\u05dc 100.8 \u05d0\u05dc\u05e3 \u05d0\u05d9\u05e9 \u05d5\u05d0\u05d9\u05e9\u05d4.\r\n\r\n\u05d1\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05e2\u05de\u05d3 \u05de\u05e1\u05e4\u05e8 \u05ea\u05d5\u05d1\u05e2\u05d9 \u05d4\u05d1\u05d8\u05d7\u05ea \u05d4\u05db\u05e0\u05e1\u05d4 \u05e2\u05dc 61.8 \u05d0\u05dc\u05e3 (\u05de\u05e0\u05d5\u05db\u05d4 \u05e2\u05d5\u05e0\u05ea\u05d9\u05d5\u05ea), \u05e0\u05ea\u05d5\u05df \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05e9\u05dc 0.4% \u05d1\u05d9\u05d7\u05e1 \u05dc\u05de\u05e1\u05e4\u05e8 \u05ea\u05d5\u05d1\u05e2\u05d9 \u05d4\u05d1\u05d8\u05d7\u05ea \u05d4\u05db\u05e0\u05e1\u05d4 \u05d1\u05d7\u05d5\u05d3\u05e9 \u05e1\u05e4\u05d8\u05de\u05d1\u05e8 \u05d1\u05d5 \u05d4\u05ea\u05d9\u05d9\u05e6\u05d1\u05d5 62.5 \u05d0\u05dc\u05e3 (\u05de\u05e0\u05d5\u05db\u05d4 \u05e2\u05d5\u05e0\u05ea\u05d9\u05d5\u05ea).", "format": "XLSX", "hash": "", "how_update": "NA", "id": "50a32c08-be13-4c73-a067-58c47dc41776", "last_modified": "2020-12-14T08:11:54.392572", "metadata_modified": "2017-03-15T09:36:30.348034", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "\u05d3\u05d5\u05e4\u05e7 \u05e9\u05d5\u05e7 \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 - \u05d0\u05e4\u05e8\u05d9\u05dc 2020", "notes": "\u05e2\u05dc \u05e4\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05ea\u05e2\u05e1\u05d5\u05e7\u05d4, \u05d1\u05d7\u05d5\u05d3\u05e9 \u05d0\u05e4\u05e8\u05d9\u05dc 2020 \u05d4\u05de\u05e9\u05d9\u05da \u05dc\u05d2\u05d3\u05d5\u05dc \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d3\u05d5\u05e8\u05e9\u05d9 \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05de\u05db\u05d5\u05d7 \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05de\u05e9\u05d1\u05e8 \u05d4\u05e7\u05d5\u05e8\u05d5\u05e0\u05d4 \u05d5\u05d4\u05d4\u05d7\u05dc\u05d8\u05d4 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05dc\u05de\u05e2\u05e1\u05d9\u05e7\u05d9\u05dd \u05dc\u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05e2\u05d5\u05d1\u05d3\u05d9\u05d4\u05dd \u05dc\u05d7\u05dc\"\u05ea, \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d9\u05e6\u05d5\u05dc \u05de\u05dc\u05d5\u05d0 \u05d9\u05de\u05d9 \u05d7\u05d5\u05e4\u05e9\u05d4 \u05e9\u05e6\u05d1\u05e8\u05d5. \u05e7\u05e6\u05d1 \u05d4\u05d2\u05d9\u05d3\u05d5\u05dc \u05d4\u05d9\u05d5\u05de\u05d9 \u05d4\u05ea\u05de\u05ea\u05df \u05d1\u05de\u05d4\u05dc\u05da \u05d7\u05d5\u05d3\u05e9 \u05d0\u05e4\u05e8\u05d9\u05dc, \u05d1\u05d9\u05d7\u05e1 \u05dc\u05d7\u05d5\u05d3\u05e9 \u05de\u05e8\u05e5, \u05d0\u05da \u05d1\u05de\u05de\u05d5\u05e6\u05e2 \u05d1\u05db\u05dc \u05d9\u05d5\u05dd \u05e0\u05e8\u05e9\u05de\u05d5 \u05db\u05de\u05e2\u05d8 6,000 \u05d3\u05d5\u05e8\u05e9\u05d9 \u05e2\u05d1\u05d5\u05d3\u05d4 \u05d7\u05d3\u05e9\u05d9\u05dd. ", "package_id": "fb39569d-2693-4147-9a39-a93bade472c5", "position": 0, "resource_type": null, "size": 19631, "state": "active", "url": "https://data.gov.il/dataset/fb39569d-2693-4147-9a39-a93bade472c5/resource/50a32c08-be13-4c73-a067-58c47dc41776/download